rules_version = '2';
// Reglas de seguridad de Firestore — proyecto mis-gastos-21e7b
//
// Modelo: cada documento lleva `userId` (lo inyecta withUser() en index.html) y
// toda lectura va filtrada por myQ() => where('userId','==',uid).
// Estas reglas hacen cumplir eso del lado del servidor: la config de Firebase es
// pública (está en index.html, repo público), así que ESTA es la única barrera real.
//
// Deploy:  firebase deploy --only firestore:rules
// Test:    firebase emulators:start --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function loggedIn() {
      return request.auth != null;
    }

    // El doc que ya existe pertenece al usuario que hace el pedido
    function owns() {
      return loggedIn() && resource.data.userId == request.auth.uid;
    }

    // El doc que se está por escribir se atribuye al usuario que hace el pedido
    function writesAsSelf() {
      return loggedIn() && request.resource.data.userId == request.auth.uid;
    }

    // El usuario de servicio del bot de Instagram (bot@marplacity.com).
    // Definido una sola vez: si algún día se regenera el usuario, se cambia acá
    // y en ningún otro lado.
    function esBot() {
      return loggedIn() && request.auth.uid == 's8mcf3uMoBc0S3G2HMR9htqLU403';
    }

    // Config del usuario: un doc por uid, la clave del doc ES el uid.
    match /config/{uid} {
      allow read, write: if loggedIn() && request.auth.uid == uid;
    }

    // Mensajes fijos que el bot manda TEXTUALES, sin pasar por el modelo (hoy: la
    // invitacion al canal de difusion). Estan escritos en primera persona del plural,
    // asi que si el modelo los tuviera a la vista arrastraria ese "nosotros" al resto
    // de la conversacion. El dueño los escribe; el bot solo los lee.
    // OJO: la regla de config/{uid} de abajo NO alcanza para este doc, porque exige
    // que la clave del doc sea el uid del que pide.
    match /config/mensajes {
      allow read:   if esBot() || owns();
      allow create: if writesAsSelf();
      allow update: if owns() && writesAsSelf();
    }

    // El interruptor del bot. Un solo doc, con un solo campo que importa: `activo`.
    // Vive en Firestore y no en una variable de Cloudflare a proposito: apagarlo tiene
    // que ser un click desde el sistema, sin deploys, en el momento en que el bot esta
    // diciendo algo que no corresponde.
    // El dueño lo escribe; el bot solo lo lee, en cada mensaje y en cada corrida del cron.
    match /config/bot {
      allow read:   if esBot() || owns();
      allow create: if writesAsSelf();
      allow update: if owns() && writesAsSelf();
    }

    // Base de conocimiento del bot: un doc por uid con los datos del local
    // (horarios, direccion, medios de pago, garantia) en texto libre.
    // El dueño escribe; el bot solo lee.
    match /conocimiento/{uid} {
      allow read, write: if loggedIn() && request.auth.uid == uid;
      allow read:        if esBot();
    }

    // Conversaciones de Instagram: un doc por cliente, con su id de Instagram como id
    // del doc. El bot lo crea con el primer DM y lo pisa con cada mensaje siguiente;
    // el cron de seguimiento necesita LEER (para correr la query de los que quedaron
    // en silencio) y ACTUALIZAR (para marcar seguimientoEnviado y los campos de la
    // bandeja). Antes solo podia crear.
    //
    // Lo que NO tiene, a proposito, es delete: si algun dia se filtra el token del
    // Worker, lo peor que puede pasar es que ensucie la bandeja, no que se lleve
    // puesto el historial de conversaciones.
    match /conversaciones/{docId} {
      // Los campos que el bot escribe de verdad. Lo que le agrega la bandeja desde el
      // sistema (quien aprobo la respuesta y cuando) queda afuera: el bot no lo toca,
      // y si intenta tocarlo el update se rechaza entero.
      function soloCamposDelBot() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'igUserId', 'userId', 'fecha', 'ultimoMensajeCliente', 'ultimoMensaje',
          'adjuntos', 'urlsAdjuntos', 'tieneImagen', 'tieneAudio',
          'estado', 'confianza', 'resumen', 'ultimoProducto', 'igUsuario',
          'mensajes', 'sugerencia', 'respondido', 'revisado', 'historial',
          'necesitaAtencion', 'motivo', 'prioridad', 'seguimientoEnviado'
        ]);
      }

      // El doc no se puede pasar a otro usuario. Sin esto, cambiarle el userId lo
      // sacaria de la vista del dueño (owns() dejaria de dar true): un delete
      // disfrazado de update, justo lo que la falta de delete quiere evitar.
      function mismoDueno() {
        return request.resource.data.userId == resource.data.userId;
      }

      allow read:           if esBot() || owns();
      allow create:         if esBot();
      allow update:         if esBot() && soloCamposDelBot() && mismoDueno();
      allow update, delete: if owns();
    }

    // Listas de precios de proveedores. El dueño las carga desde el sistema
    // (ver esColeccionDeDatos); el bot solo las lee para cotizar.
    match /listas_precios/{docId} {
      allow read: if esBot();
    }

    // Stock. El bot solo lee, para saber que hay disponible en el local.
    // OJO: estos documentos incluyen el costo. El Worker filtra y solo le pasa
    // a la IA el precio de venta, pero el permiso es sobre el doc entero.
    match /stock/{docId} {
      allow read: if esBot();
    }

    // Inventario: accesorios (cargadores, fundas, vidrios, cables). El bot solo lee,
    // para saber que hay y a que precio. Hasta el 23/08/2026 no podia, y decia que no
    // tenia cargadores mientras estaban cargados aca.
    // OJO: igual que stock, estos documentos incluyen el costo. El Worker filtra y solo
    // le pasa a la IA el precio de venta, pero el permiso es sobre el doc entero.
    match /inventario/{docId} {
      allow read: if esBot();
    }

    // Colecciones de datos: todas siguen el mismo patron userId.
    function esColeccionDeDatos(col) {
      return col in [
        'gastos', 'ingresos', 'amorts',
        'stock', 'consig', 'pagos_consig',
        'gastos_fijos', 'pagos_fijos',
        'reparaciones', 'repuestos', 'precios_repuestos',
        'inventario', 'clientes', 'encargues',
        'cierres', 'cola_impresion', 'listas_precios'
      ];
    }

    // Documentos compartidos por link de WhatsApp (facturas y ordenes en PDF).
    // El id del doc ES un token aleatorio de 128 bits que solo viaja en el link
    // que se le manda al cliente. Por eso:
    //   - `get`: abierto. Quien tiene el link, lee ese doc y nada mas.
    //   - `list`: PROHIBIDO. Si aca dijera `allow read` (que es get + list),
    //     cualquiera podria pedir la coleccion entera y bajarse las facturas y
    //     ordenes de todos los clientes. El token dejaria de proteger nada.
    match /docs_publicos/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create: if writesAsSelf();
      allow update: if owns() && writesAsSelf();
      allow delete: if owns();
    }

    match /{col}/{docId} {
      allow read:   if esColeccionDeDatos(col) && owns();
      allow create: if esColeccionDeDatos(col) && writesAsSelf();
      // update: hay que ser dueño del doc actual Y no poder reasignarlo a otro usuario
      allow update: if esColeccionDeDatos(col) && owns() && writesAsSelf();
      allow delete: if esColeccionDeDatos(col) && owns();
    }

    // Todo lo demas queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
