# Secretos de los Workers y de entornos locales.
# El repo es público: nada de esto puede llegar a un commit.
.dev.vars
.dev.vars.*
.env
.env.*

# Certificados fiscales de ARCA. Nunca, por ningún motivo, a un commit: con el .key
# cualquiera emite comprobantes a nombre del CUIT. Viven fuera del repo (~/arca-certs)
# y se suben cifrados con workers/facturador/subir-certificado.mjs.
*.key
*.crt
*.csr
*.p12
*.pfx
*.pem
.wrangler/

# Dependencias, compilación y ejecución local de Node.js.
node_modules/
dist/
.runtime/
playwright-report/
test-results/
coverage/
!.env.example
