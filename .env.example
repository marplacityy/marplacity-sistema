# El servidor escucha solamente en esta PC. Detrás de un proxy inverso: HOST=0.0.0.0 y TRUST_PROXY=loopback.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Los links compartidos con clientes (tienda, documentos). Si falta, SITIO_PUBLICO de
# src/shared/sitio.js (GitHub Pages).
# PUBLIC_BASE_URL=https://marplacityy.github.io/marplacity-sistema/

# Primera puesta en marcha: reutiliza las integraciones que ya están publicadas.
# Para ejecutar también cada integración en Node, usar "local" y cargar sus secretos.
SERVICIO_TIENDA=remoto
SERVICIO_INSTAGRAM=remoto
SERVICIO_FACTURADOR=remoto
SERVICIO_IA=remoto
SEGUIMIENTOS_ACTIVOS=false

# Las fotos no pasan por este servidor: viven en Firebase Storage (src/shared/sitio.js).

# Solo para servicios locales. Nunca completar este ejemplo con secretos reales.
# OWNER_UID=
# Máximo de llamadas de API por IP/minuto. Los pedidos públicos tienen además un límite de 10.
API_LIMITE_POR_MINUTO=120
# TIENDA_EMAIL=
# TIENDA_PASSWORD=
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# TIENDA_WEBHOOK_URL=https://tu-dominio/api/tienda/mp/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CATALOGO_URL=
# SERPAPI_KEY=
# BOT_EMAIL=
# BOT_PASSWORD=
# IG_APP_SECRET=
# IG_VERIFY_TOKEN=
# IG_ACCOUNT_ID=
# IG_TOKEN=
# ANTHROPIC_KEY=
# Quién redacta las respuestas del bot de Instagram: anthropic (default) o deepseek.
# IA_PROVEEDOR=deepseek
# DEEPSEEK_KEY=
# FAC_EMAIL=
# FAC_PASSWORD=
# ARCA_ENTORNO=homo
# ARCA_CUIT=
# CERT_MASTER_KEY=
